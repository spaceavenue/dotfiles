binds {
  // Programs
  Mod+Space   { spawn "fuzzel"; }
  Mod+A       { spawn "msc-player.py";}
  Mod+B       { spawn "firefox-nightly"; }
  Mod+D       { spawn "firefox-nightly" "--new-window" "discord.com/channels/@me"; }
  Mod+K       { spawn "keepassxc"; }
  Mod+N       { spawn "nautilus"; }
  Mod+W       { spawn "pkill" "-USR1" "waybar"; }
  Mod+S       { spawn "signal-desktop"; }
  Mod+T       { spawn "footclient"; }
  Mod+F12     { spawn "wl-screenrec" "--low-power" "off" "--codec" "hevc"; }
  Mod+Shift+N { spawn "footclient" "yazi"; }
  Mod+Shift+L { spawn "swaylock"; }
  
  // Scripts

  // Clipboard history
  Mod+Apostrophe		  { spawn "pick" "clip"; }
  Mod+Alt+Apostrophe      { spawn "pick" "clip" "--wtype";}
  Mod+Ctrl+Alt+Apostrophe { spawn "pick" "clip" "--wtype" "--nline"; }
  
  // Color picker
  Mod+Shift+Apostrophe	   { spawn "pick" "color"; }

  // Emoji picker
  Mod+Semicolon     { spawn "pick" "emoji"; }
  Mod+Alt+Semicolon	{ spawn "pick" "emoji" "--wtype"; }
  
  // Nerd font glyph picker
  Mod+Shift+Semicolon	  	{ spawn "pick" "glyph"; }
  Mod+Alt+Shift+Semicolon   { spawn "pick" "glyph" "--wtype"; }
  
  Mod+F4  { spawn "pow-menu.fish"; }	        // Power menu
  Mod+F5  { spawn "pick" "wall"; }              // Wallpaper selector
  Mod+F6  { spawn "pkill" "-USR1" "rustidle"; } // Toggle idle management

  // Open/close the Overview
  Mod {
    release { toggle-overview; }
  } 
  Mod+Q repeat=false { close-window; }    // Close window

  // Screenshot
  Mod+Shift+S { spawn-sh "niri msg screenshot-stdout interactive | satty -f -"; }
  Print       { spawn-sh "niri msg screenshot-stdout screen | satty -f -"; }
  Mod+Print   { spawn-sh "niri msg screenshot-stdout window | satty -f -"; }

  // Quit
  Mod+Shift+E     { quit; }
  Ctrl+Alt+Delete { quit; }

  // Volume keys mappings
  XF86AudioRaiseVolume allow-when-locked=true { spawn "hwctl" "vol" "u"; }
  XF86AudioLowerVolume allow-when-locked=true { spawn "hwctl" "vol" "d"; }
  XF86AudioMute        allow-when-locked=true { spawn "hwctl" "vol" "m"; }
  XF86AudioMicMute     allow-when-locked=true { spawn "hwctl" "vol" "c"; }

  // Media keys mapping
  XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
  XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
  XF86AudioStop  allow-when-locked=true { spawn "playerctl" "stop"; }
  XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
  XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }

  // Brightness key mappings
  XF86MonBrightnessUp   allow-when-locked=true { spawn "hwctl" "bl" "u" "5"; }
  XF86MonBrightnessDown allow-when-locked=true { spawn "hwctl" "bl" "d" "5"; }
}
